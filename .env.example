# MongoDB bootstrap credentials. Set strong local-development values.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# RabbitMQ management and application credentials.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Set to true to expose the Traefik dashboard at http://localhost:8080/dashboard/
TRAEFIK_DASHBOARD=true
