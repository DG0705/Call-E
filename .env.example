# MongoDB bootstrap credentials. Set strong local-development values.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# RabbitMQ management and application credentials.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Set to true to expose the Traefik dashboard at http://localhost:8080/dashboard/
TRAEFIK_DASHBOARD=true

# --- Agent service: LLM provider (Groq for real development mode) ---
# LLM_PROVIDER=mock for local development without credentials.
# LLM_PROVIDER=groq requires GROQ_API_KEY and GROQ_MODEL; startup fails fast otherwise.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=
MAX_TOOL_ITERATIONS=5
CORE_DATABASE_NAME=call_e_core
# A fresh Call-E install starts empty: no tenants, employees or knowledge.
# Create AI Employees from the frontend. This flag is currently inert (kept for
# compatibility); no customer data is auto-seeded on startup.
AGENT_SERVICE_SEED=false

# --- Voice service: STT/TTS providers (Deepgram/ElevenLabs for real mode) ---
# VOICE_STT_PROVIDER=mock needs no credentials.
# VOICE_STT_PROVIDER=deepgram requires DEEPGRAM_API_KEY; startup fails fast otherwise.
VOICE_STT_PROVIDER=mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en
# VOICE_TTS_PROVIDER=mock needs no credentials.
# VOICE_TTS_PROVIDER=elevenlabs requires ELEVENLABS_API_KEY; startup fails fast otherwise.
VOICE_TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Verify real STT/TTS credentials once at startup and log a clear diagnosis
# (e.g. TTS_PROVIDER_ERROR status=401) instead of discovering it mid-call.
# Best-effort and non-blocking. Enable for real deployments.
VOICE_PROVIDER_PREFLIGHT=false
# Voice service reaches agent-service by Docker service name inside compose.
AGENT_SERVICE_URL=http://agent-service:8000
VOICE_DATABASE_NAME=call_e_voice

# --- Knowledge service: embeddings (RAG retrieval quality) ---
# EMBEDDING_PROVIDER unset or "mock" uses a deterministic lexical-only mock:
# fine for tests, poor for real semantic retrieval (a loud warning is logged).
# For production RAG set openai_compatible + a real embeddings endpoint
# (OpenAI, Azure OpenAI, or self-hosted Ollama / text-embeddings-inference).
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30

# --- Telephony: Asterisk for real development mode ---
# TELEPHONY_PROVIDER=mock needs no PBX.
# TELEPHONY_PROVIDER=asterisk requires a reachable ASTERISK_URL; startup fails fast otherwise.
TELEPHONY_PROVIDER=mock
ASTERISK_URL=http://asterisk:8088
ASTERISK_USERNAME=
ASTERISK_PASSWORD=
# SIP registration password for the dev softphone endpoint. Injected into the
# placeholder pjsip.conf by telephony/asterisk/entrypoint.sh at container start;
# never committed. Required (with ASTERISK_PASSWORD) when running Asterisk.
DEV_PHONE_SIP_PASSWORD=
# ARI Stasis application the dialplan hands calls to (must match Stasis(...) in extensions.conf).
ASTERISK_ARI_APP=call-e
# Live inbound runner: on by default with TELEPHONY_PROVIDER=asterisk, off for mock. Force with true/false.
ASTERISK_LIVE_CALLS=
# RTP media path the voice service advertises to Asterisk (reachable name + per-call UDP ports).
VOICE_RTP_HOST=voice-service
VOICE_RTP_PORT_START=20000
VOICE_RTP_PORT_COUNT=100
VOICE_RTP_FIRST_PACKET_TIMEOUT_SECONDS=10.0
# Development inbound routing: maps one extension/DID to a tenant + employee so
# a softphone call reaches an AI Employee. Generic — set these to YOUR tenant
# and employee ids. Empty tenant/agent leaves the extension unmapped (no
# silent fallback). KAARI_DEV_* are deprecated aliases for the same values.
DEV_INBOUND_EXTENSION=1000
DEV_INBOUND_TENANT_ID=kaari-planters
DEV_INBOUND_AGENT_ID=kaari-sales-agent
KAARI_DEV_EXTENSION=
KAARI_DEV_TENANT_ID=
KAARI_DEV_AGENT_ID=
