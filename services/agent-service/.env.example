# Service configuration
SERVICE_NAME=agent-service
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
CORE_DATABASE_NAME=call_e_core
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=
MAX_TOOL_ITERATIONS=3

# Knowledge grounding for the agent runtime (agent knowledge_sources are
# resolved locally, then searched over HTTP; outages degrade to no context).
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8000
