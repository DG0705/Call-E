# Service configuration
SERVICE_NAME=voice-service
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Voice providers (mock by default for local development)
# STT
VOICE_STT_PROVIDER=mock
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en
# TTS
VOICE_TTS_PROVIDER=mock
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Agent runtime boundary
AGENT_SERVICE_URL=http://agent-service:8000

# MongoDB persistence
MONGODB_URL=mongodb://localhost:27017
VOICE_DATABASE_NAME=call_e_voice

# Telephony provider (mock by default; asterisk requires a reachable PBX)
TELEPHONY_PROVIDER=mock
ASTERISK_URL=http://asterisk:8088
# ASTERISK_USERNAME=
# ASTERISK_PASSWORD=

# Development Kaari inbound routing (extension/DID that reaches the Kaari agent)
KAARI_DEV_EXTENSION=1000
