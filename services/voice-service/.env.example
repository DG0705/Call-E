# Service configuration
SERVICE_NAME=voice-service
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Voice providers (mock by default for local development)
# STT
VOICE_STT_PROVIDER=mock
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en
# TTS
VOICE_TTS_PROVIDER=mock
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Agent runtime boundary
AGENT_SERVICE_URL=http://agent-service:8000

# MongoDB persistence
MONGODB_URL=mongodb://localhost:27017
VOICE_DATABASE_NAME=call_e_voice

# Telephony provider (mock by default; asterisk requires a reachable PBX)
TELEPHONY_PROVIDER=mock
ASTERISK_URL=http://asterisk:8088
# ASTERISK_USERNAME=
# ASTERISK_PASSWORD=
# ARI Stasis application (must match Stasis(...) in extensions.conf)
# ASTERISK_ARI_APP=call-e
# Live inbound runner (on by default with asterisk, off for mock; force true/false)
# ASTERISK_LIVE_CALLS=
# RTP media path advertised to Asterisk
# VOICE_RTP_HOST=voice-service
# VOICE_RTP_PORT_START=20000
# VOICE_RTP_PORT_COUNT=100
# VOICE_RTP_FIRST_PACKET_TIMEOUT_SECONDS=10.0

# Turn timing bounds (seconds) and end-of-speech detection (milliseconds).
# VOICE_TURN_TIMEOUT_SECONDS=30.0
# VOICE_STT_TIMEOUT_SECONDS=8.0
# VOICE_RUNTIME_TIMEOUT_SECONDS=20.0
# VOICE_TTS_TIMEOUT_SECONDS=15.0
# VOICE_END_SILENCE_MS=400
# VOICE_MIN_UTTERANCE_MS=400
# VOICE_MAX_UTTERANCE_MS=15000

# Development inbound routing: one explicitly configured extension/tenant/agent.
# DEV_INBOUND_EXTENSION=1000
# DEV_INBOUND_TENANT_ID=
# DEV_INBOUND_AGENT_ID=
# Deprecated Kaari aliases (explicit overrides only, no silent fallback).
# KAARI_DEV_EXTENSION=
# KAARI_DEV_TENANT_ID=
# KAARI_DEV_AGENT_ID=
