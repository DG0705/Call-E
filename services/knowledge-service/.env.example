# Service configuration
SERVICE_NAME=knowledge-service
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Persistence configuration
MONGODB_URL=mongodb://localhost:27017
KNOWLEDGE_DATABASE_NAME=call_e_knowledge

# Uploaded file bytes (Docker volume in compose; local dir for development)
KNOWLEDGE_STORAGE_DIR=/data/knowledge_uploads
# Maximum accepted upload size in bytes (default 10 MB)
KNOWLEDGE_MAX_FILE_BYTES=10000000

# Embeddings: mock (default, deterministic, no credentials) or
# openai_compatible (any OpenAI-compatible embeddings endpoint).
EMBEDDING_PROVIDER=mock
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_TIMEOUT_SECONDS=30
# Maximum texts sent to a real provider per embeddings request (default 64).
# EMBEDDING_BATCH_SIZE=64
